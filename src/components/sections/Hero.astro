---
import { SITE } from "../../config/site";
import { asset } from "../../lib/paths";

const { hero } = SITE;
const heroImage = asset(hero.image);
---

<section class="hero-immersive" aria-labelledby="hero-title" data-hero-canvas>
  <div class="hero-canvas" id="hero-reveal-canvas">
    <img
      src={heroImage}
      alt={hero.imageAlt}
      class="hero-backdrop"
      width="1920"
      height="1280"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-chiaroscuro" aria-hidden="true"></div>
  </div>

  <div class="container hero-stage">
    <div class="hero-text">
      <div class="hero-copy" id="hero-reveal-copy">
        <p class="hero-eyebrow">{hero.eyebrow}</p>
        <h1 id="hero-title">{hero.title}</h1>
        <p class="hero-oneline">{hero.subtitle}</p>

        <ul class="hero-highlights" aria-label="特色摘要">
          {hero.highlights.map((h) => <li>{h}</li>)}
        </ul>
      </div>

      <div class="hero-actions" id="hero-reveal-cta">
        <a class="hero-cta hero-cta--primary" href={hero.primaryCta.href} data-cta="tel">
          {hero.primaryCta.label}
        </a>
      </div>
    </div>
  </div>

  <svg class="hero-ridge" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 70V38L180 12l150 22 190-30 170 26 160-14 210 22 180-28 200 24V70z" />
  </svg>
</section>

<script>
  import gsap from "gsap";

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const canvas = document.querySelector<HTMLElement>("[data-hero-canvas]");
  const copy = document.getElementById("hero-reveal-copy");
  const cta = document.getElementById("hero-reveal-cta");
  const backdropLayer = document.getElementById("hero-reveal-canvas");

  if (!reduced && canvas && copy && cta && backdropLayer) {
    gsap.set([backdropLayer, copy, cta], { opacity: 0 });
    gsap.set(backdropLayer, { y: 10 });
    gsap.set(copy, { y: 18 });
    gsap.set(cta, { y: 14 });

    const tl = gsap.timeline({ defaults: { ease: "power2.out" } });
    tl.to(backdropLayer, { opacity: 1, y: 0, duration: 0.95 }, 0)
      .to(copy, { opacity: 1, y: 0, duration: 0.82 }, 0.12)
      .to(cta, { opacity: 1, y: 0, duration: 0.72 }, 0.58);
  }
</script>

<style>
  .hero-immersive {
    position: relative;
    min-height: 100dvh;
    max-height: 920px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: var(--color-dark-text);
    overflow: hidden;
    isolation: isolate;
    padding-block: 0;
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    z-index: -3;
    pointer-events: none;
  }

  .hero-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  .hero-chiaroscuro {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 48% 52% at 62% 38%,
        rgba(255, 236, 210, 0.22) 0%,
        rgba(80, 52, 32, 0.08) 38%,
        transparent 58%
      ),
      radial-gradient(
        ellipse 120% 95% at 50% 50%,
        transparent 22%,
        rgba(42, 26, 16, 0.55) 72%,
        rgba(32, 20, 12, 0.88) 100%
      ),
      linear-gradient(
        102deg,
        rgba(36, 22, 14, 0.92) 0%,
        rgba(48, 30, 18, 0.62) 32%,
        rgba(28, 18, 12, 0.18) 58%,
        rgba(22, 14, 10, 0.45) 100%
      );
    mix-blend-mode: multiply;
  }

  .hero-stage {
    padding: calc(var(--site-sticky-offset, 7.25rem) + var(--space-2)) var(--space-3)
      calc(var(--space-section) + 0.5rem);
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--content-width);
    margin-inline: auto;
  }

  .hero-text {
    max-width: 38rem;
  }

  .hero-eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-gold-bright);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45);
  }

  .hero-immersive h1 {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-dark-text);
    margin-bottom: 0.45rem;
    font-size: clamp(2.1rem, 8.5vw, 3.65rem);
    letter-spacing: var(--tracking-display);
    line-height: 1.08;
    text-shadow:
      0 2px 28px rgba(0, 0, 0, 0.5),
      0 0 40px rgba(42, 28, 18, 0.35);
  }

  .hero-oneline {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: 0.03em;
    line-height: 1.55;
    color: rgba(245, 234, 216, 0.94);
    max-width: var(--prose-measure);
    margin-bottom: var(--space-2);
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.45);
  }

  .hero-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
  }

  .hero-highlights li {
    font-size: 0.75rem;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(201, 169, 98, 0.42);
    color: var(--color-dark-text-muted);
    background: rgba(42, 28, 18, 0.38);
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    position: relative;
    z-index: 2;
    max-width: 20rem;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    text-decoration: none;
    border-radius: var(--radius-pill);
    transition: filter var(--transition), background var(--transition), border-color var(--transition);
  }

  .hero-cta--primary {
    min-height: 52px;
    font-size: 1rem;
    font-weight: 700;
    background: var(--gradient-accent);
    box-shadow: var(--shadow-glow);
    border: none;
    color: var(--color-on-accent);
  }

  .hero-cta--primary:hover {
    filter: brightness(1.06);
    color: var(--color-on-accent);
  }

  .hero-cta--ghost {
    min-height: 42px;
    font-size: 0.8125rem;
    font-weight: 600;
    background: transparent;
    border: 1px solid rgba(224, 200, 120, 0.45);
    color: rgba(245, 234, 216, 0.94);
    box-shadow: none;
  }

  .hero-cta--ghost:hover {
    background: rgba(42, 28, 18, 0.45);
    color: var(--color-dark-text);
  }

  .hero-ridge {
    display: block;
    width: 100%;
    height: 70px;
    margin-top: -1px;
    position: relative;
    z-index: 1;
  }

  .hero-ridge path {
    fill: var(--color-bg);
  }

  @media (min-width: 768px) {
    .hero-oneline {
      font-size: 1.2rem;
    }
  }

  @media (min-width: 1440px) {
    .hero-immersive {
      max-height: none;
      min-height: min(92vh, 980px);
    }

    .hero-stage {
      padding-bottom: calc(var(--space-section) * 1.15);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-canvas,
    .hero-copy,
    .hero-actions {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
