---
import { SITE } from "../../config/site";
import { asset } from "../../lib/paths";

const { hero, vi } = SITE;
const heroImage = asset(hero.image);
---

<section class="hero-immersive" aria-labelledby="hero-title">
  <img
    src={heroImage}
    alt={hero.imageAlt}
    class="hero-backdrop"
    width="1920"
    height="1280"
    fetchpriority="high"
    decoding="async"
  />
  <span class="hero-watermark" aria-hidden="true">{vi.imageWatermark} · 示意影像</span>

  <div class="container hero-stage">
    <div class="hero-text" id="hero-beat-root">
      <p class="hero-eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-title">{hero.title}</h1>
      <p class="hero-oneline">{hero.subtitle}</p>

      <ul class="hero-highlights" aria-label="特色摘要">
        {hero.highlights.map((h) => <li>{h}</li>)}
      </ul>

      <div class="hero-actions">
        <a class="button" href={hero.primaryCta.href} data-cta="tel">
          {hero.primaryCta.label}
        </a>
        <a
          class="button button-hero-alt"
          href={hero.secondaryCta.href}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="fb"
        >
          {hero.secondaryCta.label}
        </a>
      </div>
    </div>
  </div>

  <svg class="hero-ridge" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 70V38L180 12l150 22 190-30 170 26 160-14 210 22 180-28 200 24V70z" />
  </svg>
</section>

<script>
  import gsap from "gsap";

  const root = document.getElementById("hero-beat-root");
  if (root && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    gsap.from(root, {
      opacity: 0,
      y: 28,
      duration: 0.9,
      ease: "power2.out",
      delay: 0.15,
    });
  }
</script>

<style>
  .hero-immersive {
    position: relative;
    min-height: 100dvh;
    max-height: 920px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: var(--color-dark-text);
    overflow: hidden;
    isolation: isolate;
    padding-block: 0;
  }

  .hero-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
    z-index: -3;
  }

  .hero-immersive::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(180deg, rgba(26, 22, 18, 0.55) 0%, rgba(26, 22, 18, 0.25) 38%, rgba(26, 22, 18, 0.88) 100%),
      linear-gradient(105deg, rgba(26, 22, 18, 0.92) 0%, rgba(26, 22, 18, 0.5) 48%, rgba(26, 22, 18, 0.2) 100%);
  }

  .hero-watermark {
    position: absolute;
    right: var(--space-2);
    bottom: 5rem;
    z-index: 2;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: rgba(244, 237, 228, 0.5);
    writing-mode: vertical-rl;
  }

  .hero-stage {
    padding: calc(var(--site-sticky-offset, 7.25rem) + var(--space-2)) var(--space-3)
      calc(var(--space-section) + 0.5rem);
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--content-width);
    margin-inline: auto;
  }

  .hero-text {
    max-width: 36rem;
  }

  .hero-eyebrow {
    margin: 0 0 var(--space-2);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: var(--color-dark-text-muted);
  }

  .hero-immersive h1 {
    color: var(--color-dark-text);
    margin-bottom: 0.35rem;
    font-size: clamp(1.85rem, 8vw, 3.25rem);
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
  }

  .hero-oneline {
    font-size: var(--text-base);
    color: var(--color-dark-text);
    max-width: 26rem;
    margin-bottom: var(--space-2);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.4);
  }

  .hero-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
  }

  .hero-highlights li {
    font-size: 0.75rem;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(168, 146, 114, 0.35);
    color: var(--color-dark-text-muted);
    background: rgba(26, 22, 18, 0.35);
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    position: relative;
    z-index: 2;
  }

  @media (min-width: 768px) {
    .hero-actions {
      flex-direction: row;
      flex-wrap: wrap;
      max-width: 28rem;
    }

    .hero-actions .button:first-child {
      flex: 1.15 1 10rem;
    }

    .hero-actions .button:last-child {
      flex: 1 1 9rem;
    }
  }

  .hero-actions .button {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    color: var(--color-on-accent);
  }

  .hero-actions .button:hover {
    color: var(--color-on-accent);
  }

  .button-hero-alt {
    background: var(--gradient-accent);
    box-shadow: var(--shadow-glow);
    border: none;
  }

  .hero-ridge {
    display: block;
    width: 100%;
    height: 70px;
    margin-top: -1px;
    position: relative;
    z-index: 1;
  }

  .hero-ridge path {
    fill: var(--color-bg);
  }

  @media (min-width: 768px) {
    .hero-oneline {
      font-size: var(--text-lg);
    }
  }

  @media (min-width: 1440px) {
    .hero-immersive {
      max-height: none;
      min-height: min(92vh, 980px);
    }

    .hero-stage {
      padding-bottom: calc(var(--space-section) * 1.15);
    }
  }
</style>
