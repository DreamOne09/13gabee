---
import { SITE } from "../../config/site";

const { openingHours, business, ui, hoursNote, routeWarnings, visitOptions } = SITE;

const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(
  `${SITE.name} ${business.address.street} ${business.address.city}`
)}`;
---

<section id="info" class="section section-alt">
  <div class="container">
    {ui.infoEyebrow && <p class="section-eyebrow">{ui.infoEyebrow}</p>}
    <h2>{ui.infoTitle}</h2>
    <div class="grid-2">
      <div class="card">
        <h3>{ui.hoursTitle}</h3>
        <table class="hours-table">
          <tbody>
            {
              openingHours.map((h) => (
                <tr>
                  <th scope="row">{h.label}</th>
                  <td>{h.closed ? ui.closedLabel : `${h.opens} – ${h.closes}`}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        {hoursNote && <p class="hours-note">{hoursNote}</p>}

        <h3 class="subhead">{routeWarnings.title}</h3>
        <ul class="route-list">
          {routeWarnings.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="card">
        <h3>{ui.findUsTitle}</h3>
        <p>
          {business.address.city}{business.address.street}<br />
          {business.accessNote}
        </p>
        <p>
          <a href={`tel:${business.phone}`}>{business.phoneDisplay}</a>
        </p>
        <p class="info-actions">
          <a class="button" href={directionsUrl} target="_blank" rel="noopener noreferrer">
            {ui.directionsLabel}
          </a>
          <a
            class="button button-secondary"
            href={business.googleBusinessUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {ui.googleProfileLabel}
          </a>
          <a
            class="button button-secondary"
            href={business.facebookUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Facebook 粉專
          </a>
        </p>

        <h3 class="subhead">如何前往</h3>
        <ul class="visit-options">
          {
            visitOptions.map((opt) => (
              <li>
                <strong>{opt.label}</strong>
                {opt.detail}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hours-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .hours-table th {
    text-align: left;
    font-weight: 600;
    padding: 0.4rem 0;
  }

  .hours-table td {
    text-align: right;
    color: var(--color-text-muted);
  }

  .hours-table tr + tr {
    border-top: 1px solid var(--color-border);
  }

  .hours-note {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .subhead {
    margin-top: var(--space-3);
    font-size: 1rem;
  }

  .route-list,
  .visit-options {
    margin: 0.5rem 0 0;
    padding-left: 1.1rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .visit-options {
    list-style: none;
    padding: 0;
  }

  .visit-options li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .visit-options strong {
    display: block;
    color: var(--color-text);
    font-size: 0.8rem;
    margin-bottom: 0.15rem;
  }

  .info-actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }

  @media (min-width: 768px) {
    .grid-2 {
      gap: var(--space-4);
    }
  }
</style>
