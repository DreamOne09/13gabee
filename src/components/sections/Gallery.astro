---
import { SITE } from "../../config/site";
import { asset } from "../../lib/paths";

const { gallery } = SITE;
---

<section id="gallery" class="section gallery-feature">
  <div class="container">
    {gallery.eyebrow && <p class="section-eyebrow">{gallery.eyebrow}</p>}
    <h2>{gallery.title}</h2>
    {"lead" in gallery && gallery.lead && <p class="gallery-lead">{gallery.lead}</p>}
    <div class="gallery-grid">
      {
        gallery.images.map((image) => (
          <figure class="gallery-item">
            <img
              src={asset(image.src)}
              alt={image.alt}
              loading="lazy"
              width="400"
              height="300"
              class="gallery-image"
            />
          </figure>
        ))
      }
      <p class="gallery-demo-once" aria-hidden="true">{SITE.vi.imageWatermark}</p>
    </div>
  </div>
</section>

<style>
  .gallery-feature {
    padding-block: var(--space-section);
  }

  .gallery-lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
    max-width: 36rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: minmax(140px, 1fr);
    gap: 0.65rem;
    position: relative;
  }

  .gallery-demo-once {
    position: absolute;
    right: 0.25rem;
    bottom: 0.15rem;
    z-index: 3;
    margin: 0;
    font-size: 0.48rem;
    letter-spacing: 0.06em;
    color: rgba(74, 61, 50, 0.28);
    pointer-events: none;
    user-select: none;
  }

  .gallery-item:first-child {
    grid-column: 1 / span 3;
    grid-row: span 2;
    min-height: 280px;
  }

  .gallery-item:nth-child(2) {
    grid-column: 4 / span 3;
    grid-row: span 2;
  }

  .gallery-item:nth-child(n + 3) {
    grid-column: span 2;
    min-height: 180px;
  }

  .gallery-item {
    margin: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    position: relative;
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms ease;
  }

  .gallery-item::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 62%, rgba(29, 20, 13, 0.5) 100%);
    opacity: 0;
    transition: opacity var(--transition);
  }

  @media (hover: hover) {
    .gallery-item:hover .gallery-image {
      transform: scale(1.05);
    }

    .gallery-item:hover::after {
      opacity: 1;
    }
  }

  @media (max-width: 820px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 150px;
    }

    .gallery-item:first-child,
    .gallery-item:nth-child(2) {
      grid-column: span 2;
      grid-row: span 1;
      min-height: 200px;
    }

    .gallery-item:nth-child(n + 3) {
      grid-column: span 1;
    }
  }

  @media (min-width: 1440px) {
    .gallery-grid {
      gap: 0.85rem;
      grid-auto-rows: minmax(160px, 1fr);
    }

    .gallery-item:first-child {
      min-height: 360px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-item:hover .gallery-image {
      transform: none;
    }
  }
</style>
