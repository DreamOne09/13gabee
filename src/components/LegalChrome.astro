---
import { SITE } from "../config/site";

const { legalChrome } = SITE;
---

<details class="legal-chrome">
  <summary class="legal-chrome-summary">
    <span>{legalChrome.banner}</span>
  </summary>
  <div class="container legal-chrome-body">
    <p class="legal-chrome-full-title">{legalChrome.disclaimerTitle}</p>
    <p>{legalChrome.disclaimerBody}</p>
  </div>
</details>

<style>
  .legal-chrome {
    background: var(--color-ink-navy);
    color: var(--color-dark-text-muted);
    border-bottom: 1px solid rgba(245, 241, 234, 0.1);
    font-size: 0.68rem;
  }

  .legal-chrome-summary {
    display: block;
    padding: 0.38rem var(--space-3);
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    color: var(--color-dark-text-muted);
    letter-spacing: 0.03em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: center;
  }

  .legal-chrome-summary::-webkit-details-marker {
    display: none;
  }

  .legal-chrome-body {
    padding: 0 0 0.55rem;
    font-size: 0.75rem;
    line-height: 1.6;
    max-width: 52rem;
  }

  .legal-chrome-full-title {
    font-weight: 700;
    color: var(--color-dark-text);
    margin: 0 0 0.35rem;
  }

  .legal-chrome-body p:last-child {
    margin: 0;
  }
</style>
